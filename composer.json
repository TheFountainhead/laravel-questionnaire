{
    "name": "thefountainhead/laravel-questionnaire",
    "description": "Generic weighted questionnaire engine for Laravel",
    "type": "library",
    "license": "proprietary",
    "_php_note": "php stays ^8.2 on purpose: Laravel 13 and testbench 11 require ^8.3, so on PHP 8.2 Composer simply resolves back to L11/L12 — no install break, just no L13. Raising the floor would lock out L11/L12 consumers, which defeats the point of the widened constraints.",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "TheFountainhead\\Questionnaire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheFountainhead\\Questionnaire\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheFountainhead\\Questionnaire\\QuestionnaireServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
